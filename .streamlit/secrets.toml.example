# Salin menjadi .streamlit/secrets.toml (lokal) atau isi di Streamlit Cloud -> Settings -> Secrets.

[neon]
url = "postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

[bootstrap_admin]            # dipakai SEKALI saat tabel users masih kosong
username = "admin"
password = "ganti-dengan-sandi-kuat"

[sensor_sheet]
url = "https://script.google.com/macros/s/XXXX/exec"
read_key = "KUNCI_BACA"
source_type = "DUMMY"        # DUMMY selama umpan masih uji; ubah ke SENSOR hanya bila perangkat nyata terpasang

[bmkg]
adm4 = "32.10.15.2003"       # Desa Panongan (bawaan)

[somat]                      # semua opsional
refresh_sensor_s = 90
refresh_forecast_s = 1800
refresh_warning_s = 300
max_h_age_hours = 30         # batas umur h manual; nilai sementara, tetapkan lewat pilot
rec_expiry_hours = 6
background_fetch = true
