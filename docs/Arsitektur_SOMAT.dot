digraph Architecture {
 graph [rankdir=TB,bgcolor="#FFFFFF",pad=0.35,nodesep=0.32,ranksep=0.5,fontname="DejaVu Sans",label="SOMAT  |  ARSITEKTUR TUJUAN\nStreamlit + Neon • modul fisika terpisah • pelatihan AI offline",labelloc=t,fontsize=21,fontcolor="#12352E"];
 node [shape=box,style="rounded,filled",fillcolor="#EDF5F2",color="#93B8AA",fontname="DejaVu Sans",fontsize=11,fontcolor="#153A31",margin="0.18,0.13"];
 edge [color="#537D70",arrowsize=0.7,fontname="DejaVu Sans",fontsize=9,fontcolor="#35564B"];
 manual [label="PETUGAS\nh petak manual\n1–2 kali sehari"];
 sensor [label="PERANGKAT LAPANGAN\nKelembapan petak\nMuka air saluran"];
 weather [label="SUMBER EKSTERNAL\nBMKG prakiraan\nSuhu/hujan pengamatan"];
 ui [label="STREAMLIT\nForm h • monitoring\nPrediksi • keputusan • pelaksanaan",fillcolor="#DCECF8",color="#8EADC4"];
 adapters [label="ADAPTER DAN VALIDASI\nGoogle Sheets / endpoint sensor\nBMKG / stasiun • waktu • unit • QC"];
 db [label="NEON POSTGRESQL\nObservations • profil versi • arsip prakiraan\nRekomendasi • keputusan • pelaksanaan • audit",width=6.7,fillcolor="#DCECF8",color="#8EADC4"];
 service [label="RECOMMENDATION SERVICE\nSnapshot per petak • sumber dan versi\nPemeriksaan waktu, mutu, parameter, dan expiry",width=6.7];
 et [label="ET0\nHS_v1 + versi konfigurasi\nPengamatan / prakiraan terpisah"];
 phys [label="PHYSICS ENGINE\nETc • F • lintasan h\nAWD • volume • durasi"];
 supply [label="HIDRAULIK\nKurva tinggi–debit\nQ saluran → Q petak"];
 result [label="HASIL DAN TINDAKAN\nMode + alasan → APPROVE / MODIFY / DELAY\nPelaksanaan aktual dicatat terpisah",width=6.7,fillcolor="#DCECF8",color="#8EADC4"];
 offline [label="PELATIHAN OFFLINE\nLabel valid • split temporal\nRF pembanding baseline",fillcolor="#FFF3DD",color="#C9AC70"];
 registry [label="MODEL REGISTRY\nDataset • fitur • ET0 • metrik\nShadow → versi disetujui",fillcolor="#FFF3DD",color="#C9AC70"];
 manual -> ui;
 sensor -> adapters [label="gateway / Sheets"];
 weather -> adapters;
 ui -> db [label="input dan kejadian"];
 adapters -> db;
 db -> service;
 service -> et;
 service -> supply;
 et -> phys;
 supply -> phys;
 phys -> result;
 result -> db [label="snapshot + audit",constraint=false,style=dashed];
 result -> ui [label="tampilan",constraint=false,style=dashed];
 db -> offline [label="snapshot historis"];
 offline -> registry;
 registry -> phys [label="residual versi aktif",constraint=false];
 {rank=same; manual; sensor; weather}
 {rank=same; ui; adapters}
 {rank=same; et; supply; registry}
}
